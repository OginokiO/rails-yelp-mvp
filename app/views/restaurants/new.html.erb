<h1>New Restaurant</h1>

<%= simple_form_for @restaurant do |f| %>
  <%= f.input :name, label: "Restaurant name", required: true %>
  <%= f.input :address, label: "Address", required: true %>
  <%= f.input :phone_number, label: "Phone number" %>
  <%= f.input :category, label: "Category", collection: %w[chinese italian japanese french belgian], required: true %>

  <%= f.button :submit, "Create restaurant", class: "btn btn-primary" %>
<% end %>

<%= link_to "Back to list", restaurants_path, class: "btn btn-secondary" %>
